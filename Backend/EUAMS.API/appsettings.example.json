{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "Cors": { "AllowedOrigins": [ "http://localhost:5173", "http://127.0.0.1:5173" ] },
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SERVER;Database=EUAMSDb;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True",
    "DLRDbConnect": "Server=YOUR_SERVER;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True",
    "CesarDbContext": "Server=YOUR_SERVER;Database=YOUR_DB;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True"
  },
  "Storage": {
    "Provider": "Local",
    "RootPath": "YOUR_LOCAL_DOCS_PATH",
    "Endpoint": "localhost:9000",
    "AccessKey": "YOUR_ACCESS_KEY",
    "SecretKey": "YOUR_SECRET_KEY",
    "Bucket": "ellipse-documents",
    "UseSsl": false,
    "CreateBucketIfNotExists": true
  },
  "Email": {
    "Enabled": false,
    "Host": "YOUR_SMTP_HOST",
    "Port": 25,
    "EnableSsl": false,
    "FromAddress": "no-reply@example.com",
    "Credentials": { "EmailAddress": "YOUR_EMAIL", "Password": "YOUR_EMAIL_PASSWORD" },
    "FromDisplayName": "Ellipse UAMS",
    "LineManagerInbox": "line.manager@example.com",
    "TrainingCentreInbox": "training@example.com",
    "IctManagerInbox": "ict.manager@example.com",
    "HcSystemsOfficerInbox": "hc.officer@example.com"
  },
  "ApiSettings": {
    "Secret": "YOUR_LONG_RANDOM_JWT_SECRET",
    "Issuer": "YOUR_ISSUER",
    "Audience": "YOUR_AUDIENCE",
    "LoginApiUrl": "https://YOUR_LOGIN_API_URL"
  }
}
